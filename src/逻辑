// 复制：根据当前列(ssyq手术要求 / zysx注意事项)从弹窗取内容追加到当前单元格
event clicked;Long ll_row,ll_lb
String ls_1,ls_ssyq,ls_zysx,ls_col

ll_row = dw_1.GetRow()
If dw_1.AcceptText() < 0 Then Return
If ll_row <= 0 Then Return
ls_col = Lower(dw_1.GetColumnName())
Choose Case ls_col
	Case 'ssyq'
		ll_lb = 1
	Case 'zysx'
		ll_lb = 2
	Case Else
		Return
End Choose
//OpenWithParm(w_ss_gxmk_copy,ll_lb)
ls_1 = Message.StringParm
If IsNull(ls_1) Then ls_1 = ''
If ls_1 <> '' Then
	Choose Case ll_lb
		Case 1
			ls_ssyq = dw_1.GetItemString(1,'ssyq')
			If IsNull(ls_ssyq) Then ls_ssyq = ''
			dw_1.SetItem(ll_row,'ssyq',ls_ssyq+ls_1)
			dw_1.SetFocus()
			dw_1.SetColumn('ssyq')
			dw_1.SelectText(Len(ls_ssyq+ls_1)+1,1)
		Case 2
			ls_zysx = dw_1.GetItemString(1,'zysx')
			If IsNull(ls_zysx) Then ls_zysx = ''
			dw_1.SetItem(ll_row,'zysx',ls_zysx+ls_1)
			dw_1.SetFocus()
			dw_1.SetColumn('zysx')
			dw_1.SelectText(Len(ls_zysx+ls_1)+1,1)
	End Choose
	cb_save.Enabled = True
	ib_RowModified  = True
End If


end event

