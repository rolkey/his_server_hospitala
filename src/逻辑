//-------- 住院号/床号输入：. 开头按床号查 ZY_CWSZ，否则按住院号查 ZY_BRRY，带出病人 --------
event modified;Double ldbl_zyh
String ls_srdm // 输入代码
String ls_Message

If ib_RowModified Then
	If MessageBox('提示','当前手术安排是否保存?',question!,yesno!,1) = 1 Then
		If Not wf_save() Then
			This.Text = ''
			Return
		End If
	End If
End If

ls_srdm = em_srdm.Text
If Len(ls_srdm) = 0 Then Return

If Left(ls_srdm,1) = "." Then
	// 以点开头：按床号查床位表得住院号
	ls_srdm = Mid(ls_srdm,2)
	ls_Message = "病人床号"
	SELECT ZYH Into :ldbl_zyh From ZY_CWSZ Where BRCH = :ls_srdm USING sqlca;
Else
	// 否则按住院号查在院病人
	ls_Message = "住院号码"
	SELECT ZYH  Into :ldbl_zyh From ZY_BRRY Where ZYHM = :ls_srdm And CYPB < 2 USING sqlca;
End If

If ldbl_zyh > 0 Then
	dw_1.Enabled = True
	wf_ssbr(ldbl_zyh)
Else
	MessageBox("提示信息",ls_Message + "为【" + ls_srdm + "】的病人不存在，请重新输入住院号码!")
	This.SetFocus()
End If


end event

