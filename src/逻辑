//-------- 窗口初始化：按 LongParm[1] 模式(0查看/1新增/2修改/3急诊) 设置界面并加载数据 --------
public function boolean wf_init ();Double ldbl_ssbh // 手术编号（LongParm[6]）
Long   ll_row
DateTime ldt_csny
DateTime ldt_date
datawindowchild child1

ldt_date = f_serverdatetime()

dw_1.SetTransObject(sqlca)
dw_1.GetChild('xshs',child1)
//gf_ss_gxmk_hs(child1)
dw_1.GetChild('xshs_2',child1)
//gf_ss_gxmk_hs(child1)
dw_1.GetChild('xhhs',child1)
//gf_ss_gxmk_hs(child1)
dw_1.GetChild('xhhs_2',child1)
//gf_ss_gxmk_hs(child1)
//uo_1.Initialize(sqlca,"SSMC,SSNM,ZJDM","GY_SSDM","1,3","730,220","2","ue_getitem01")

ldbl_ssbh = istru_Exchange.LongParm[6] //Double(Mid(is_Parameter,2))
Choose Case string(istru_Exchange.LongParm[1]) //Left(is_Parameter,1)
	Case "0"
		// 模式0：仅查看，隐藏录入区
		This.Title = "查看手术安排通知单"
		st_srdm.Visible     = False
		em_srdm.Visible     = False
		cbx_lxlr.Visible    = False
		cb_blankout.Visible = False
		//dw_1.Enabled        = False
	Case "1"
		// 模式1：新增；LongParm[6]>0 表示从申请单复制（传的是申请单号 sqdh）
		This.Title = "手术安排"
		dw_1.InsertRow(0)
		ll_row = istru_Exchange.LongParm[6] //Long(Mid(is_Parameter,2))
		If ll_row > 0 Then
			st_srdm.Visible = False
			em_srdm.Visible = False
			cbx_lxlr.Visible = False
			cbx_lxlr.Checked = False
			cb_blankout.Visible = False
			//dw_1.DeleteRow(1) 屏蔽该行否则不能正常显示窗口
			wf_copy_source(ldbl_ssbh)  // 从申请单复制到安排单
			dw_1.SetFocus()
			dw_1.ScrollToRow(1)
			cb_save.Enabled = True
		Else
			// 纯新增：不复制，焦点到住院号输入
			cb_blankout.Visible = False
			//dw_1.Enabled = False
			em_srdm.SetFocus()
		End If
		Return True
	Case "2"
		// 模式2：修改，下面统一按 ssbh 检索
		This.Title = "修改手术安排通知单"
		st_srdm.Visible = False
		em_srdm.Visible = False
		cbx_lxlr.Visible = False
		cbx_lxlr.Checked = False
	Case "3"
		// 模式3：急诊手术安排，锁定急诊标志
		This.Title = "急诊手术安排"
		il_ssks = Long(Mid(is_Parameter,2)) //手术室代码,有手术系统中使用
		ib_jzss = True
		cb_blankout.Visible = False
		dw_1.InsertRow(0)
		dw_1.Modify("jzbz.protect='1'")
		dw_1.Object.jzbz[1] = 1
		em_srdm.SetFocus()
		Return True
	Case Else
End Choose

// 按手术编号检索安排单（查看/修改时）
dw_1.Retrieve(ldbl_ssbh)  //,ldt_date
If dw_1.RowCount() = 0 Then
	MessageBox("提示信息", "手术安排单【" + String(ldbl_ssbh) + "】不存在!",stopsign!)
	cb_blankout.Enabled = False
	CloseWithReturn(This,0)
	Return False
Else
	ib_zfbz = False	//手术申请作废标志
	If dw_1.Object.zfbz[1] = 1 Then
		cb_blankout.Text = "取消作废"
		ib_zfbz = True	//手术申请作废标志
	End If
//	If Not IsNull(dw_1.Object.ssnm[1]) Then
//		dw_1.Object.ssmc.protect = '1'
//	End If
End If

Return True

end function

