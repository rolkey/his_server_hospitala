//-------- 医师/护士列：输入后弹出人员选择窗(GY_YGDM)，回填工号 --------
//=============================================================================
// Added By Sunlf 2001.12.13
//=============================================================================
String   ls_ColumnName
String   ls_ColumnText
st_public_Select lstr_Select

ls_ColumnName = Upper(dwo.Name)
ls_ColumnText = Trim(Data)

Choose Case ls_ColumnName
	Case "SSYS" , "SSYZ" , "SSEZ" , "SSSZ" , "MZYS" , "SSYS_2" , "MZYS_2"
		// 手术/麻醉医师：科室分配=Y，按工号/拼音模糊查
		If Not ib_EditChanged Then Return 0
		
		ib_EditChanged = False
		
		If IsNull(ls_ColumnText) Or Len(ls_ColumnText) = 0 Then
			Return 0
		End If
		
		If Pos(ls_ColumnText,"'") > 0 Or &
			Pos(ls_ColumnText,'"') > 0 Or &
			Pos(ls_ColumnText,"%") > 0 Then
			MessageBox("提示信息","数据录入错误，请修改!",Exclamation!)
			This.SetText("")
			Return 1
		End If
		
		lstr_Select.CoList      = " GY_YGDM.YGDM  , GY_YGDM.YGXM , GY_YGDM.PYDM "
		lstr_Select.TabList     = " GY_YGDM "
		lstr_Select.WhereClause = "  ( GY_YGDM.KCFQ = 'Y' ) AND " + &
			" (( GY_YGDM.YGDM LIKE '" + ls_ColumnText + "%' ) OR " + &
			"  ( GY_YGDM.PYDM LIKE '" + ls_ColumnText + "%' ) )  " + &
			" ORDER BY GY_YGDM.YGDM "
		lstr_Select.DispCols    = "1,2,3"
		lstr_Select.DispWidths  = "260,300,300"
		lstr_Select.ReturnCols  = "1"
		
		
		lstr_Select.trans = sqlca
		OpenWithParm(w_public_select,lstr_Select)
		
		lstr_Select = Message.PowerObjectParm
		
		If lstr_Select.Suceed < 1 Then
			This.SetText("")
			Return 1 // 选择失败
		End If
		This.SetItem(row,ls_ColumnName,lstr_Select.ReturnValue[1])
//		This.SetText(lstr_Select.ReturnValue[1])
//		Post Send(Handle(This),256,9,0)
		Return 1 // 由于重新赋值，所以不接受当前值Data
	Case "XSHS","XSHS_2","XHHS","XHHS_2"
		// 洗手/巡回护士：未作废人员，按工号/拼音模糊查
		If Not ib_EditChanged Then Return 0
		
		ib_EditChanged = False
		
		If IsNull(ls_ColumnText) Or Len(ls_ColumnText) = 0 Then
			Return 0
		End If
		
		If Pos(ls_ColumnText,"'") > 0 Or &
			Pos(ls_ColumnText,'"') > 0 Or &
			Pos(ls_ColumnText,"%") > 0 Then
			MessageBox("提示信息","数据录入错误，请修改!",Exclamation!)
			This.SetText("")
			Return 1
		End If
		
		lstr_Select.CoList      = " GY_YGDM.YGDM  , GY_YGDM.YGXM , GY_YGDM.PYDM "
		lstr_Select.TabList     = " GY_YGDM "
		lstr_Select.WhereClause = "  ( GY_YGDM.ZFPB <> '1' ) AND " + &
			" (( GY_YGDM.YGDM LIKE '" + ls_ColumnText + "%' ) OR " + &
			"  ( GY_YGDM.PYDM LIKE '" + ls_ColumnText + "%' ) )  " + &
			" ORDER BY GY_YGDM.YGDM "
		lstr_Select.DispCols    = "1,2,3"
		lstr_Select.DispWidths  = "260,300,300"
		lstr_Select.ReturnCols  = "1"
		
		
		lstr_Select.trans = sqlca
		OpenWithParm(w_public_select,lstr_Select)
		
		lstr_Select = Message.PowerObjectParm
		
		If lstr_Select.Suceed < 1 Then
			This.SetText("")
			Return 1 // 选择失败
		End If
		This.SetItem(row,ls_ColumnName,lstr_Select.ReturnValue[1])
//		This.SetText(lstr_Select.ReturnValue[1])
//		Post Send(Handle(This),256,9,0)
		Return 1 // 由于重新赋值，所以不接受当前值Data
	Case Else
End Choose

ib_EditChanged = False

Return 0
//=============================================================================



end event

