// 作废/取消作废：若作废则检查是否已有会诊/谈话/麻醉/器械/手术/费用/术后等记录，有则不允许作废
event clicked;String ls_Message

If This.Text = "作废(&B)" Then
	/* 检查是否已录入其它记录 */
	If dw_1.Object.hzbz[1] = 1 Then ls_Message += "会诊记录、"
	If dw_1.Object.thbz[1] = 1 Then ls_Message += "谈话记录、"
	If	dw_1.Object.mzbz[1] = 1 Then ls_Message += "麻醉记录、"
	If	dw_1.Object.qxbz[1] = 1 Then ls_Message += "器械准备、"
	If	dw_1.Object.ssbz[1] = 1 Then ls_Message += "手术记录、"
	If	dw_1.Object.jfbz[1] = 1 Then ls_Message += "手术费用、"
	If	dw_1.Object.shbz[1] = 1 Then ls_Message += "术后信息、"
	If Len(ls_Message) > 0 Then
		ls_Message = Left(ls_Message,Len(ls_Message) - 2)
		MessageBox("提示","该通知单已录入" + ls_Message + "，不能作废!",Exclamation!)
		Return
	End If
	This.Text = "取消作废"
	dw_1.Object.zfbz[1] = 1
	ib_zfbz = True		//手术申请作废标志
Else
	This.Text = "作废(&B)"
	dw_1.Object.zfbz[1] = 0
	ib_zfbz = False	//手术申请作废标志
End If
ib_RowModified  = True
cb_save.Enabled = True

end event

