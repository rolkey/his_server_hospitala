//-------- 事件：从手术选择控件(uo_1)回填手术信息到 dw_1 --------
event ue_getitem01();long ll_row,ll_return,ll_ssnm
string ls_ssmc
any lany_1[]

ll_row=dw_1.getrow()
ll_return=uo_1.getselected(lany_1)
IF ll_return>0 THEN
	ll_ssnm=lany_1[1]
   IF ll_ssnm > 0 THEN
      // 从手术字典取手术名称，写入安排单并定位到手术医师列
      SELECT SSMC INTO :ls_ssmc FROM GY_SSDM WHERE SSNM = :ll_ssnm USING sqlca;
      dw_1.object.ssnm[1] = ll_ssnm
      dw_1.object.ssmc[1] = ls_ssmc	
		dw_1.setcolumn('ssys')
	else
		// 选择为空则清空手术编码/名称，焦点到手术名称
		setnull(ll_ssnm)
		setnull(ls_ssmc)
		dw_1.setitem(1,'ssnm',ll_ssnm)
		dw_1.setitem(1,'ssmc',ls_ssmc)
		dw_1.setcolumn('ssmc')
   END IF
else
	// 未选择则清空
	setnull(ll_ssnm)
	setnull(ls_ssmc)
	dw_1.setitem(1,'ssnm',ll_ssnm)
	dw_1.setitem(1,'ssmc',ls_ssmc)
	dw_1.setcolumn('ssmc')
END IF
dw_1.setfocus()

end event

//-------- 根据住院号带出手术病人信息并填入 dw_1 第1行 --------
public subroutine wf_ssbr (double adbl_zyh);/* 定义数据存储对象 lds_ssbr 用以选择手术病人 */
Long ll_zyh,ll_brxb,ll_brks,ll_brbq,ll_brxz
Long ll_nl,ll_sqdh,ll_ssnm,ll_mzdm,ll_sqks
String ls_zyid,ls_zyhm,ls_brxm,ls_brch,ls_ssmc,ls_ssys_2
String ls_xshs,ls_xhhs,ls_xshs_2,ls_xhhs_2
String ls_mzys_2,ls_ssyq,ls_zysx,ls_czgh
String ls_ssys,ls_ssyz,ls_ssez,ls_sssz,ls_mzys,ls_shbz
DateTime ldt_csny
DateTime	ldt_date
DataStore lds_ssbr

ldt_date = f_serverdatetime()

lds_ssbr = Create DataStore
lds_ssbr.DataObject = "d_ss_gxmk_sssq_ssbr"
lds_ssbr.SetTransObject(sqlca)

If lds_ssbr.Retrieve(adbl_zyh) = 0 Then
	MessageBox("提示信息","病人不存在，请重新输入!")
	em_srdm.SetFocus()
Else
	// 从检索结果取病人及申请单信息
	ll_sqdh= lds_ssbr.GetItemNumber(1,'sqdh')
	ll_zyh  = lds_ssbr.GetItemNumber(1,'zyh')
	ls_zyhm = lds_ssbr.GetItemString(1,'zyhm')
	ls_brxm = lds_ssbr.GetItemString(1,'brxm')
	ll_brxb = lds_ssbr.GetItemNumber(1,'brxb')
	ldt_csny = lds_ssbr.GetItemDateTime(1,'csny')
	ll_brks = lds_ssbr.GetItemNumber(1,'brks')
	ll_brbq = lds_ssbr.GetItemNumber(1,'brbq')
	ls_brch = lds_ssbr.GetItemString(1,'brch')
	ll_brxz = lds_ssbr.GetItemNumber(1,'brxz')
	ls_shbz = lds_ssbr.GetItemString(1,'shbz')
	ls_zyid = lds_ssbr.GetItemString(1,'zyid')
	if isnull(ls_shbz) then ls_shbz='0'
	
	SetNull(ll_sqdh)
	SetNull(ll_ssnm)
	SetNull(ls_ssmc)
	SetNull(ls_ssys)
	SetNull(ls_ssyz)
	SetNull(ls_ssez)
	SetNull(ls_sssz)
	SetNull(ll_mzdm)
	SetNull(ls_mzys)
	SetNull(ls_xshs)
	SetNull(ls_xhhs)
	SetNull(ls_xshs_2)
	SetNull(ls_xhhs_2)
	SetNull(ls_ssys_2)
	SetNull(ls_mzys_2)
	SetNull(ls_ssyq)
	SetNull(ls_zysx)
	ls_czgh = gstr_ainf.u_userid
	// 病人信息、申请单号写入 dw_1，手术相关字段先置空
	dw_1.Object.sqdh[1] = ll_sqdh
	dw_1.Object.zyid[1]  = ls_zyid
	dw_1.Object.zyh[1]  = ll_zyh
	dw_1.Object.zyhm[1] = ls_zyhm
	dw_1.Object.brxm[1] = ls_brxm
	dw_1.Object.brxb[1] = ll_brxb
	dw_1.Object.csny[1] = ldt_csny
	dw_1.Object.brks[1] = ll_brks
	dw_1.Object.brbq[1] = ll_brbq
	dw_1.Object.brch[1] = ls_brch
	dw_1.Object.brxz[1] = ll_brxz
	dw_1.object.ssrq[1] = ldt_date
	dw_1.Object.ssnm[1] = ll_ssnm
	dw_1.Object.ssmc[1] = ls_ssmc
	dw_1.Object.ssys[1] = ls_ssys
	dw_1.Object.ssyz[1] = ls_ssyz
	dw_1.Object.ssez[1] = ls_ssez
	dw_1.Object.sssz[1] = ls_sssz
	dw_1.Object.mzdm[1] = ll_mzdm
	dw_1.Object.mzys[1] = ls_mzys
	dw_1.Object.ssbh[1] = 0
	dw_1.Object.xshs[1] = ls_xshs
	dw_1.Object.xhhs[1] = ls_xhhs
	dw_1.Object.xshs_2[1] = ls_xshs_2
	dw_1.Object.xhhs_2[1] = ls_xhhs_2
	dw_1.Object.ssys_2[1] = ls_ssys_2
	dw_1.Object.mzys_2[1] = ls_mzys_2
	dw_1.object.aprq[1] = ldt_date
	dw_1.Object.jzbz[1] = 0
	dw_1.Object.hzbz[1] = 0
	dw_1.Object.thbz[1] = 0
	dw_1.Object.mzbz[1] = 0
	dw_1.Object.qxbz[1] = 0
	dw_1.Object.ssbz[1] = 0
	dw_1.Object.zfbz[1] = 0
	dw_1.Object.jfbz[1] = 0
	dw_1.Object.wcbz[1] = 0
	dw_1.Object.shbz[1] = 0
	dw_1.Object.ssyq[1] = ls_ssyq
	dw_1.Object.zysx[1] = ls_zysx
	dw_1.Object.czgh[1] = ls_czgh
	dw_1.Object.shbz[1] = long(ls_shbz)
	
	// 手术系统中使用此模块时传入手术科室
	If Not IsNull(il_ssks) And il_ssks > 0 Then
		dw_1.Object.ssks[1] = il_ssks
	End If
	
	If ib_jzss Then dw_1.Object.jzbz[1] = 1  // 急诊模式则勾选急诊标志
	dw_1.SetFocus()
End If

Destroy lds_ssbr


end subroutine

//-------- 保存手术安排：校验 → 新增/修改/作废 处理申请单 → Update --------
public function boolean wf_save ();Long 		ll_zfbz
Double 	ldbl_ssbh , ldbl_sqdh
String  	ls_Error,ls_col,ls_Brch,ls_Brxm
string ls_zybh,ls_Brbq,ls_Brks

// 1. 接受当前编辑并校验
IF dw_1.AcceptText() < 0 THEN
	MessageBox('提示','当前数据录入不正确，请重新录入!')
	dw_1.SetFocus()
	RETURN False
END IF

if dw_1.Object.ssrq[1] < dw_1.Object.aprq[1] then
	MessageBox('提示','手术日期不能小于通知日期!')
	dw_1.SetFocus()
	dw_1.SetColumn('ssrq')
	RETURN False
END IF
	

ls_Brch = dw_1.Object.rycw[1]
ls_Brxm = dw_1.Object.brxm[1]
ls_zybh  = dw_1.Object.zybh[1]
ls_Brbq = dw_1.Object.cyksid[1]
ls_Brks = dw_1.Object.zkksid[1]

ldbl_ssbh = dw_1.Object.ssbh[1]
ldbl_sqdh = dw_1.Object.sqdh[1]

// 2. 必填项校验：手术医师、手术名称
IF IsNull(dw_1.Object.ssys[1]) And Not IsNull(dw_1.Object.ssys_2[1])THEN
ls_Error += "主治医师、"
ls_col = 'ssys'
END IF
IF IsNull(dw_1.Object.ssys[1]) And IsNull(dw_1.Object.ssys_2[1])THEN
ls_Error += "手术医师、"
ls_col = 'ssys'
END IF
IF dw_1.Object.ssdm[1] = ''  Or IsNull(dw_1.Object.ssdm[1]) THEN
	ls_Error += "手术名称、"
	ls_col = 'ssmc'
END IF
IF Len(ls_Error) > 0 THEN
	ls_Error = Left(ls_Error , Len(ls_Error) - 2)
	MessageBox("提示信息",ls_Error + "不能为空，请重新输入!",Exclamation!)
	dw_1.SetFocus()
	dw_1.SetColumn(ls_col)
	RETURN False
END IF

// 3. 新增：取手术编号，并更新/插入申请单状态
/* 若为新增记录，则从SS_SSAP中取最大SSBH(手术编号) */
IF ldbl_ssbh = 0 THEN
	ldbl_ssbh = gf_get_max(sqlca,"SM_SSAP",1)
	IF ldbl_ssbh < 0 THEN GOTO Process_Error
	
	dw_1.Object.ssbh[1] = ldbl_ssbh
	dw_1.Object.czgh[1] = gstr_ainf.u_userid
	/* 有申请单：将 SM_SSSQ.APBZ 置 1 表示已安排；无申请单则调用 wf_fill_sssq 补一条 */
	IF ldbl_sqdh > 0 THEN
		gf_begin_transaction(sqlca)
		UPDATE SM_SSSQ Set APBZ = 1 Where SQDH = :ldbl_sqdh Using sqlca;
		IF sqlca.SQLCode <> 0 THEN GOTO Process_Error
	ELSE //没有申请单则新增一条记录
		IF wf_fill_sssq() < 0 THEN GOTO Process_Error
	END IF
	ii_ReturnValue = 1
ELSE
	// 4. 修改：若作废则把申请单 APBZ 改回 0
	gf_begin_transaction(sqlca)
	ll_zfbz = dw_1.Object.zfbz[1]
	IF ll_zfbz = 1 THEN
		UPDATE SM_SSSQ Set APBZ = 0 Where SQDH = :ldbl_sqdh Using sqlca;
		IF sqlca.SQLCode <> 0 THEN GOTO Process_Error
		ii_ReturnValue = 3
	ELSE
		ii_ReturnValue = 2
	END IF
END IF

////麻醉完成标志
//IF IsNull(dw_1.Object.mzwcbz[1]) THEN
//	dw_1.SetItem(1,"MZWCBZ",0)
//END IF
//
// 5. 写库并提交
IF dw_1.Update() <> 1 THEN GOTO Process_Error

gf_commit_transaction(sqlca)
ib_RowModified = False
cb_save.Enabled = False

IF IsNull(ls_Brch) THEN ls_Brch = '未知'
IF IsNull(ls_Brxm) THEN ls_Brxm = '未知'
IF IsNull(ls_Brbq) THEN ls_Brbq = ''
IF IsNull(ls_zybh)  THEN ls_zybh = ''
IF IsNull(ls_Brks) THEN ls_Brks = ''

//gf_support_MsgSend('804('+ls_Brch+','+ls_Brxm+',)|'+String(ll_Zyh)+'|8,11|'+String(ll_Brbq)+','+String(ll_Brks)+'|0|0')

RETURN True

Process_Error:
// 保存失败：回滚并记录错误
is_error = sqlca.SQLERRTEXT
gf_rollback_transaction(sqlca)
//gf_inserterrlog(0,is_error,'w_ss_gxmk_ssap','wf_save','wf_save',0)
ii_ReturnValue = 0
is_error = '位置：w_ss_gxmk_ssap ：wf_save() ' + is_error
//	gf_his_share_errorinfo('数据保存错误，请修改!',is_error)
RETURN False
end function

//-------- 无申请单时往 SM_SSSQ 补一条申请记录并回写 sqdh（INSERT 当前被注释） --------
public function integer wf_fill_sssq ();Long 		ll_sqdh,ll_zyh,ll_sqks,ll_ssnm,ll_mzdm,ll_tjbz,ll_apbz,ll_zfbz,ll_ssks
String 	ls_sqys,ls_czgh,ls_ssyz,ls_ssez,ls_sssz,ls_mzys,ls_ssys
DateTime ldt_sqrq,ldt_ssrq
DateTime	ldt_date

ldt_date = f_serverdatetime()
//ll_sqdh = gf_ss_gxmk_max_dh('sqdh') //取单号并在SM_IDENTITY中填值
ll_sqdh = gf_get_max(sqlca,"SM_SSSQ",1) 
If ll_sqdh < 0 Then Return -1
ll_zyh = dw_1.Object.zyh[1]
ll_sqks = dw_1.Object.sqks[1]
ll_ssks = dw_1.Object.ssks[1]
ll_ssnm = dw_1.Object.ssnm[1]
ll_mzdm = dw_1.Object.mzdm[1]
ll_tjbz = 9
ll_apbz = 1
ll_zfbz = 0
SetNull(ls_sqys)
ls_czgh = gstr_ainf.u_userid
ls_ssyz = dw_1.Object.ssyz[1]
ls_ssez = dw_1.Object.ssez[1]
ls_sssz = dw_1.Object.sssz[1]
ls_mzys = dw_1.Object.mzys[1]
ls_ssys = dw_1.object.ssys[1]
ldt_sqrq= ldt_date
ldt_ssrq = dw_1.Object.ssrq[1]

gf_begin_transaction(sqlca)
//INSERT INTO SM_SSSQ(SQDH,ZYH,SQKS,SQYS,SQRQ,SSKS,SSRQ,SSNM,SSYZ,SSEZ,SSSZ,MZDM,MZYS,TJBZ,APBZ,ZFBZ,CZGH,SSYS,TXKS)
//	VALUES(:ll_sqdh,:ll_zyh,:ll_sqks,:ls_sqys,:ldt_sqrq,:ll_ssks,:ldt_ssrq,:ll_ssnm,:ls_ssyz,:ls_ssez,
//	:ls_sssz,:ll_mzdm,:ls_mzys,:ll_tjbz,:ll_apbz,:ll_zfbz,:ls_czgh,:ls_ssys,:iu_xtcs.il_sssdm)
//	USING sqlca;
	
If sqlca.SQLCode <> 0 Then
	is_error = sqlca.SQLERRTEXT
	gf_rollback_transaction(sqlca)
	//gf_inserterrlog(0,is_error,'w_ss_gxmk_ssap','wf_fill_sssq','wf_fill_sssq',0)
	is_error = '位置：w_ss_gxmk_ssap ：wf_fill_sssq() ' + is_error
	//gf_his_share_errorinfo('数据库更新失败!',is_error)
	Return -1
Else
	gf_commit_transaction(sqlca)
	dw_1.Object.SQDH[1] = ll_sqdh
	Return 1
End If


end function

