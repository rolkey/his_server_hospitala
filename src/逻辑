//-------- 关闭前询问：有未保存修改时提示保存/放弃/取消 --------
event closequery;Integer li_rtn

If ib_RowModified Then
	li_rtn = MessageBox("提示信息","数据已改变，需要保存吗?",Question!,YesNoCancel!,1)
	If li_rtn = 1 Then       // 是：保存后关闭
		If wf_save() Then
			CloseWithReturn(This,ii_ReturnValue)
			Return 1
		Else
			Return 1
		End If
	ElseIf li_rtn = 2 Then  // 否：不保存直接关
		Return 0
	Else                     // 取消：不关闭
		Return 1
	End If
End If

end event

