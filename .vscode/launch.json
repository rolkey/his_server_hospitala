{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "医生站服务",
            "skipFiles": [
                "<node_modules>/**",
                "<disk>/**"
            ],
            "runtimeExecutable": "pnpm", // 或 "npm"、"yarn"
            "runtimeArgs": [
                "run",
                "start:debug"
            ], // 对应 package.json 中的脚本
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}", // 确保工作目录正确
            "envFile": "${workspaceFolder}/.env" // 设置环境变量文件路径
        }
    ]
}